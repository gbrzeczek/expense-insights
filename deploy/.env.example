# Copy to deploy/.env (git-ignored) and adjust. Dev-only defaults; never reuse them in production.
POSTGRES_DB=expense_insights
POSTGRES_USER=expense_insights
POSTGRES_PASSWORD=dev_only_password
POSTGRES_PORT=5432
API_PORT=8080

# Sign-in (see deploy/README.md). Leave empty to disable Google sign-in.
AUTH_OWNER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
