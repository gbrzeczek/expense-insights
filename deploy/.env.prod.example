# Production settings for docker-compose.prod.yml and deploy/scripts/*. On the server, copy to
# deploy/.env (git-ignored), chmod 600, and fill in every value. See deploy/README.md.

# --- Database -------------------------------------------------------------------------------
POSTGRES_DB=expense_insights
POSTGRES_USER=expense_insights
# Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# --- Sign-in (Google OAuth client, redirect URI https://<APP_HOST>/api/auth/callback/google) --
AUTH_OWNER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- HTTPS edge (Caddy) ---------------------------------------------------------------------
APP_HOST=expenses.gbrzeczek.dev
# The server's Tailscale IPv4 address (tailscale ip -4). Caddy listens only there.
TAILSCALE_IP=
# acme = Let's Encrypt via the Cloudflare DNS challenge; internal = self-signed (local testing).
TLS_MODE=acme
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=
# Cloudflare API token with Zone:DNS:Edit on gbrzeczek.dev only (for the DNS-01 challenge).
CLOUDFLARE_API_TOKEN=

# Loopback port of the API on the server (deploy.sh health check).
API_PORT=8080

# --- Backups (deploy/scripts/backup.sh) -----------------------------------------------------
BACKUP_DIR=/var/backups/expense-insights
# Public key from age-keygen (age1...). The private key never lives on the server.
AGE_RECIPIENT=
# rclone remote and bucket for the off-site copy, e.g. r2:expense-insights-backups.
# Empty = local only.
RCLONE_REMOTE=
KEEP_DAILY=14
KEEP_MONTHLY=6

# --- Monitoring (optional dead man's switches, e.g. healthchecks.io ping URLs) --------------
BACKUP_PING_URL=
HEALTH_PING_URL=
