# The production deploy/.env. You don't write this file: the Deploy workflow generates it on the
# server from the GitHub environment `production` (deploy/README.md, step 8). This lists what it
# contains, for reference and for running the stack from a checkout by hand. Values are
# single-quoted so Compose reads them literally.

# --- Database -------------------------------------------------------------------------------
POSTGRES_PASSWORD=''

# --- Sign-in (Google OAuth client, redirect URI https://<APP_HOST>/api/auth/callback/google) --
AUTH_OWNER_EMAIL=''
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''

# --- HTTPS edge (Caddy) ---------------------------------------------------------------------
APP_HOST='expenses.gbrzeczek.dev'
# The server's Tailscale IPv4 address (tailscale ip -4). Caddy listens only there.
TAILSCALE_IP=''
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=''
# Cloudflare API token with Zone:DNS:Edit on gbrzeczek.dev only (for the DNS-01 challenge).
CLOUDFLARE_API_TOKEN=''
# Not written by the workflow; defaults: TLS_MODE=acme (internal = self-signed, for local
# testing), API_PORT=8080 (the API's loopback port on the server).

# --- Backups (deploy/scripts/backup.sh) -----------------------------------------------------
BACKUP_DIR='/var/backups/expense-insights'
# Public key from age-keygen (age1...). The private key never lives on the server.
AGE_RECIPIENT=''
# rclone remote for the off-site copy; `r2` is defined from the R2_* values below. Empty = local only.
RCLONE_REMOTE='r2:expense-insights-backups'
R2_ENDPOINT='https://<account id>.r2.cloudflarestorage.com'
R2_ACCESS_KEY_ID=''
R2_SECRET_ACCESS_KEY=''
# Not written by the workflow; defaults: KEEP_DAILY=14, KEEP_MONTHLY=6.

# --- Monitoring (optional dead man's switches, e.g. healthchecks.io ping URLs) --------------
BACKUP_PING_URL=''
HEALTH_PING_URL=''

# --- Images ---------------------------------------------------------------------------------
# The commit whose GHCR images run (set by the workflow). `local` = images built from a checkout.
IMAGE_TAG='local'
