{
  "Database": {
    "MigrateOnStartup": true
  },
  "Import": {
    "Ing": {
      "PaymentProcessors": [ "PayU", "Cashbill", "PayPro", "Przelewy24", "Tpay", "Autopay", "Dotpay" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*"
}
